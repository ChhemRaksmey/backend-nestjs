<div class="vertical-menu">
    <div class="h-100" data-simplebar="">
        <div id="sidebar-menu">
            <ul class="metismenu list-unstyled" id="side-menu">

                <li class="menu-title" key="t-menu">Menu</li>

                <li>
                    <a class="py-1 pb-2 font-size-12 waves-effect" href="/" aria-expanded="false">
                        <span key="t-chat">User Interface</span>
                    </a>
                </li>

                <% let currentModuleId = ''; %>

                <% sidebarItems.forEach((item, index) => { %>
                    
                    <% if (item.id_module !== currentModuleId) { %>
                        <% if (index > 0) { %></ul></li><% } %>
                        <li>
                            <a class="py-1 font-size-12 has-arrow waves-effect" href="javascript: void(0);">
                                <span><%= item.module_full_name %></span>
                            </a>
                            <ul aria-expanded="false" class="sub-menu">
                        <% currentModuleId = item.id_module; %>
                    <% } %>

                    <li>
                        <a class="font-size-12 ps-5" href="<%= item.base_url %>"><%= item.full_name %></a>
                    </li>

                <% }); %>

                <% if (sidebarItems.length > 0) { %></ul></li><% } %>

            </ul>
        </div>
    </div>
</div>