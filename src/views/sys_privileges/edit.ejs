
<form class="card" method="post" action="<%= baseurl %>/update/<%= record ? record.id_privilege : '' %>">

    <div class="card-body border-bottom pb-2">
        <div class="d-flex align-items-center">
            <div class="flex-grow-1">
                <h5 class="mb-1 card-title"><%= pageTitle %></h5>
                <p class="text-muted mb-0"><%= pageDscr %></p>
            </div>
            <div class="flex-shrink-0">
                <button class="btn btn-soft-primary" type="submit" name="client-submt" value="submit-update" title="Submit Update"><i class="fas fa-check"></i></button>
                <a class="btn btn-soft-secondary" role="button" href="<%= baseurl %>" title="Cancel"><i class="fas fa-level-up-alt"></i></a>
            </div>
        </div>
    </div>

    <div class="card-body">

        <%- include('../components/show_errors') %>
        
        <ul class="nav nav-tabs nav-tabs-custom" role="tablist">
            <li class="nav-item" role="presentation">
                <a class="nav-link active" data-bs-toggle="tab" href="#tabMaster" role="tab" aria-selected="true">
                    <span class="d-none d-sm-block">Master</span>
                </a>
            </li>
            <li class="nav-item" role="presentation">
                <a class="nav-link" data-bs-toggle="tab" href="#tabAudit" role="tab" aria-selected="false" tabindex="-1">
                    <span class="d-none d-sm-block">Audit</span>
                </a>
            </li>
        </ul>

        <div class="tab-content p-3 text-muted">
            
            <div class="tab-pane active" id="tabMaster" role="tabpanel">
                <div class="row">
                    
                    <div class="mb-2 col-md-6">
                        <label class="form-label mb-1">Full Name</label>
                        <input class="form-control" name="full_name" value="<%= oldvalue ? oldvalue.full_name : '' %>"  />
                        <% if (errors && errors.full_name) { %><small class="text-danger"><%= errors.full_name[0] %></small><% } %>
                    </div>
                    
                    <div class="mb-2 col-md-2">
                        <label class="form-label mb-1">Main Module</label>
                        <select class="form-select select2" name="enable_status" value="<%= oldvalue && oldvalue.enable_status %>">
                            <option value="Y" <%= oldvalue && oldvalue.enable_status === 'Y' ? 'selected' : '' %>>Enable</option>
                            <option value="N" <%= oldvalue && oldvalue.enable_status === 'N' ? 'selected' : '' %>>Disabled</option>
                        </select>
                        <% if (errors && errors.id_module) { %><small class="text-danger"><%= errors.id_module[0] %></small><% } %>
                    </div>

                    <% if(list_applications) { %>

                        <% let main_module = ""; %>

                        <ul class="nav nav-tabs nav-tabs-custom" role="tablist">
                            <% list_applications.forEach((item, index) => { %>
                                <% if(main_module !== item.id_module) { %>
                                    <li class="nav-item" role="presentation">
                                        <a class="nav-link <% if (index === 0) { %>active<% } %>" data-bs-toggle="tab" href="#tabModule-<%= item.id_module %>" role="tab" aria-selected="true">
                                            <span class="d-none d-sm-block"><%= item.module_full_name %></span>
                                        </a>
                                    </li>
                                <% } %>
                                <% main_module = item.id_module; %>
                            <% }); %>
                        </ul>

                        <% main_module = ""; %>
                        <div class="tab-content p-3 text-muted">
                            <% list_applications.forEach((item, index) => { %>
                                <% if (item.id_module !== main_module) { %>

                                    <% if (index > 0) { %>
                                            </tbody>
                                        </table>
                                    </div>
                                    <% } %>
                                    
                                    <div class="tab-pane <% if(index === 0) { %> active <% } %>" role="tabpanel" id="tabModule-<%= item.id_module %>">
                                        <table class="table table-striped table-borderless">
                                            <thead>
                                                <tr>
                                                    <th class="py-1 col-3">Applications Name</th>
                                                    <th class="py-1 col-9">
                                                        <div class="form-check me-3">
                                                            <label class="form-check-label">
                                                                <input class="form-check-input me-2" type="checkbox" onchange="toggleAllRows(this)" />
                                                                Permissions
                                                            </label>
                                                        </div>
                                                    </th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                        
                                    <% main_module = item.id_module; %>
                                <% } %>
                                    
                                            <tr>
                                                <td class="py-1">
                                                    <div class="form-check me-3">
                                                        <label class="form-check-label">
                                                            <input class="form-check-input me-2" type="checkbox" onchange="toggleRowCheckboxes(this)" />
                                                            <%= item.full_name %>
                                                        </label>
                                                    </div>
                                                </td>
                                                <td class="py-1 d-flex">
                                                    <% list_permissions.forEach((item2, index2) => { %>
                                                        <div class="form-check me-3">
                                                            <label class="form-check-label">
                                                                <input class="form-check-input" type="checkbox"
                                                                    name="permission[<%= item.id_application %>][<%= item2.recid %>]"
                                                                    <% if (oldvalue && oldvalue.permission && oldvalue.permission[item.id_application] && oldvalue.permission[item.id_application][item2.recid] === 'on') { %> checked <% } %>
                                                                />
                                                                <%= item2.narrative %>
                                                            </label>
                                                        </div>
                                                    <% }); %>
                                                </td>
                                            </tr>

                            <% }); %>

                                        </tbody>
                                    </table>
                                </div>
                            </div>

                    <% } %>

                </div>
            </div>

            <div class="tab-pane" id="tabAudit" role="tabpanel"></div>

        </div>

    </div>

</form>


<script>

    function toggleRowCheckboxes(masterCheckbox) {
        const row = masterCheckbox.closest('tr');
        const checkboxes = row.querySelectorAll('input[type="checkbox"]');
        checkboxes.forEach(checkbox => {
            checkbox.checked = masterCheckbox.checked;
        });
    }

    function toggleAllRows(masterCheckbox) {
        const table = masterCheckbox.closest('table');
        const checkboxes = table.querySelectorAll('tbody input[type="checkbox"]');
        checkboxes.forEach(checkbox => {
            checkbox.checked = masterCheckbox.checked;
        });
    }
</script>