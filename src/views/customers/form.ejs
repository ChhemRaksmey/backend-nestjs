<section class="page-heading">
  <div>
    <p class="eyebrow">CUSTOMER DIRECTORY</p>
    <h1><%= isEdit ? 'Edit customer' : 'Add a customer' %></h1>
    <p class="muted"><%= isEdit ? 'Update this customer’s details.' : 'Enter the details to create a customer record.' %></p>
  </div>
</section>
<% if (errorMessage) { %>
  <div class="alert alert-error" role="alert"><%= errorMessage %></div>
<% } %>
<section class="panel form-panel">
  <form action="<%= formAction %>" method="post">
    <%- include('../components/customer-form') %>
  </form>
</section>
