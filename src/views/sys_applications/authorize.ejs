
<form class="card" method="post" action="<%= baseurl %>/authorize/<%= values ? values.id_application : '' %>">

    <div class="card-body border-bottom pb-2">
        <div class="d-flex align-items-center">
            <div class="flex-grow-1">
                <h5 class="mb-1 card-title"><%= pageTitle %></h5>
                <p class="text-muted mb-0"><%= pageDscr %></p>
            </div>
            <div class="flex-shrink-0">
                <button class="btn btn-soft-success" type="submit" name="client-submt" value="submit-approve" title="Submit Approve"><i class="fas fa-check"></i></button>
                <button class="btn btn-soft-danger" type="submit" name="client-submt" value="submit-delete" title="Submit Delete"><i class="fas fa-trash"></i></button>
                <a class="btn btn-soft-secondary" role="button" href="<%= baseurl %>" title="Cancel"><i class="fas fa-level-up-alt"></i></a>
            </div>
        </div>
    </div>

    <div class="card-body">

        <% if (msg) { %>
          <div class="alert alert-info" role="status"><%= msg %></div>
        <% } %>

        <% if (errors && Object.keys(errors).length) { %>
          <div class="alert alert-danger" role="alert">
            <p class="mb-1">Please fix the following fields:</p>
            <ul class="mb-0">
              <% Object.values(errors).flat().forEach((message) => { %>
                <li><%= message %></li>
              <% }) %>
            </ul>
          </div>
        <% } %>
        
        <ul class="nav nav-tabs nav-tabs-custom" role="tablist">
            <li class="nav-item" role="presentation">
                <a class="nav-link active" data-bs-toggle="tab" href="#tabMaster" role="tab" aria-selected="true">
                    <span class="d-none d-sm-block">Master</span>
                </a>
            </li>
            <li class="nav-item" role="presentation">
                <a class="nav-link" data-bs-toggle="tab" href="#tabAudit" role="tab" aria-selected="false" tabindex="-1">
                    <span class="d-none d-sm-block">Audit</span>
                </a>
            </li>
        </ul>

        <div class="tab-content p-3 text-muted">
            
            <div class="tab-pane active" id="tabMaster" role="tabpanel">

                <div class="row">
                    
                    <div class="mb-3 col-md-3">
                        <label class="form-label mb-1">Main Module</label>
                        <input class="form-control" readonly value="<%= values ? values.module_full_name : '' %>" />
                    </div>
                    
                    <div class="mb-3 col-md-4">
                        <label class="form-label mb-1">Full Name</label>
                        <input class="form-control" readonly value="<%= values ? values.full_name : '' %>" />
                    </div>

                    <div class="mb-3 col-md-3">
                        <label class="form-label mb-1">Base URL</label>
                        <input class="form-control" readonly value="<%= values ? values.base_url : '' %>" />
                    </div>
                    
                    <div class="mb-3 col-md-2">
                        <label class="form-label mb-1">Status</label>
                        <input class="form-control" readonly value="<%= (values && values.enable_status === 'Y')? "Enable" : "Disabled" %>" />
                    </div>

                </div>

            </div>

            <div class="tab-pane" id="tabAudit" role="tabpanel"></div>

        </div>

    </div>

</form>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    "use strict";
  });
</script>
