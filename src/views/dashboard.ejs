
<section class="page-heading">
  <div>
    <p class="eyebrow">OVERVIEW</p>
    <h1>Good to see you</h1>
    <p class="muted">A simple workspace to manage your customer records.</p>
  </div>
  <a class="button button-primary" href="/customers/new">＋ Add customer</a>
</section>

<section class="stats-grid">
  <article class="stat-card">
    <span class="stat-label">Total customers</span>
    <strong class="stat-number"><%= customerCount %></strong>
    <span class="stat-caption">Records in your workspace</span>
  </article>
  <article class="welcome-card">
    <div class="welcome-icon">✦</div>
    <div>
      <h2>Your customer hub</h2>
      <p>Create, update, and organize customer information from one place.</p>
      <a class="text-link" href="/customers">View all customers <span aria-hidden="true">→</span></a>
    </div>
  </article>
</section>

