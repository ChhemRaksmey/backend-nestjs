
<section>
  <div class="card">

    <div class="card-body border-bottom pb-2">
      <div class="d-flex align-items-center">
        <div class="flex-grow-1">
          <h5 class="mb-1 card-title"><%= pageTitle %></h5>
          <p class="text-muted mb-0"><%= pageDscr %></p>
        </div>
        <div class="flex-shrink-0">
          <a class="btn btn-soft-primary" href="<%= baseurl %>?client-action=page-create"><i class="fas fa-plus me-2"></i>Add New</a>
          <a class="btn btn-soft-secondary" href="<%= baseurl %>"><i class="fas fa-sync-alt"></i></a>
        </div>
      </div>
    </div>

    <div class="card-body">
      <% if (total) { %>

        <form class="card-body border-bottom pt-1" method="get" action="<%= baseurl %>">
          <div class="row g-2 justify-content-center">
            <div class="col-lg-3">
              <input class="form-control" placeholder="Search for ..." />
            </div>
            <div class="col-lg-3">
              <select class="form-select select2">
                <option value="" selected>All Branches</option>
                <option value="Y">Enable</option>
                <option value="N">Disabled</option>
              </select>
            </div>
            <div class="col-lg-3">
              <select class="form-select select2">
                <option value="" selected>All Privileges</option>
                <option value="Y">Enable</option>
                <option value="N">Disabled</option>
              </select>
            </div>
            <div class="col-lg-2">
              <select class="form-select select2">
                <option value="" selected>All Status</option>
                <option value="Y">Active</option>
                <option value="Y">Expired</option>
                <option value="Y">Locked</option>
                <option value="Y">Reset Password</option>
              </select>
            </div>
            <div class="col-lg-1">
              <button class="btn btn-soft-secondary w-100" type="submit">
                <i class="mdi mdi-filter-outline align-middle"></i>Filter
              </button>
            </div>
          </div>
        </form>

        <table class="table table-striped align-middle dt-responsive nowrap w-100 table-check" id="job-list">
          <thead>
            <tr>
              <th scope="col" class="font-size-12 py-2">Signon Name</th>
              <th scope="col" class="font-size-12 py-2">Full Name</th>
              <th scope="col" class="font-size-12 py-2">Branch Name</th>
              <th scope="col" class="font-size-12 py-2">Privilege Name</th>
              <th scope="col" class="font-size-12 py-2 text-center">Status</th>
              <th scope="col" class="font-size-12 py-2 text-center">Action</th>
            </tr>
          </thead>
          <tbody>
            <% records.forEach((item) => { %>
              <tr>
                <td class="font-size-12 py-1"><%= item.signon_name %></td>
                <td class="font-size-12 py-1"><%= item.full_name %></td>
                <td class="font-size-12 py-1"><%= item.id_branch %></td>
                <td class="font-size-12 py-1"><%= item.id_privilege %></td>
                <td class="font-size-12 py-1 text-center"><%= item.user_status %></td>
                <td class="font-size-12 py-1 text-center">
                  <div class="btn-group">
                    <a aria-expanded="false" aria-haspopup="true" class="btn-sm btn btn-soft-primary" data-bs-toggle="dropdown" role="button">
                      <i class="mdi mdi-file-cog-outline"></i>
                    </a>
                    <div class="dropdown-menu">
                      <a class="dropdown-item font-size-12" href="<%= baseurl %>?client-action=page-view&amp;recid=<%= item.id_user %>">View</a>
                      <div class="dropdown-divider"></div>
                      <a class="dropdown-item font-size-12" href="<%= baseurl %>?client-action=page-update&amp;recid=<%= item.id_user %>">Edit</a>
                      <a class="dropdown-item font-size-12" href="<%= baseurl %>?client-action=page-reset-password&amp;recid=<%= item.id_user %>">Reset Password</a>
                      <div class="dropdown-divider"></div>
                      <a class="dropdown-item font-size-12" href="<%= baseurl %>?client-action=page-authorize&amp;recid=<%= item.id_user %>">Authorize</a>
                    </div>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>

        <%- include('../components/pagination') %>

      <% } else { %>
        <div class="text-center">
          <h3><%= title %></h3>
          <p>Add first module to get start</p>
        </div>
      <% } %>
    </div>

  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    "use strict";
    <% if (msg) { %>
      toastr["success"]("<%= msg %>");
    <% } %>
  });
</script>
