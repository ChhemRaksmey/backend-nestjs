
<form class="card" method="post" action="<%= baseurl %>">

    <input type="hidden" name="recid" value="<%= oldvalue.id_user ?? '' %>" />

    <div class="card-body border-bottom pb-2">
        <div class="d-flex align-items-center">
            <div class="flex-grow-1">
                <h5 class="mb-1 card-title"><%= pageTitle %></h5>
                <p class="text-muted mb-0"><%= pageDscr %></p>
            </div>
            <div class="flex-shrink-0">
                <button class="btn btn-soft-primary" type="submit" name="client-action" value="submit-reset-password" title="Submit Reset Password"><i class="fas fa-check"></i></button>
                <a class="btn btn-soft-secondary" role="button" href="<%= baseurl %>" title="Cancel"><i class="fas fa-level-up-alt"></i></a>
            </div>
        </div>
    </div>

    <div class="card-body">

        <%- include('../components/show_errors') %>
        
        <ul class="nav nav-tabs nav-tabs-custom" role="tablist">
            <li class="nav-item" role="presentation">
                <a class="nav-link active" data-bs-toggle="tab" href="#tabMaster" role="tab" aria-selected="true">
                    <span class="d-none d-sm-block">Master</span>
                </a>
            </li>
            <li class="nav-item" role="presentation">
                <a class="nav-link" data-bs-toggle="tab" href="#tabAudit" role="tab" aria-selected="false" tabindex="-1">
                    <span class="d-none d-sm-block">Audit</span>
                </a>
            </li>
        </ul>

        <div class="tab-content p-3 text-muted">
            
            <div class="tab-pane active" id="tabMaster" role="tabpanel">
                <div class="row g-2">

                    <div class="mb-2 col-md-2">
                        <label class="form-label mb-1">Staff Id</label>
                        <input class="form-control" name="staff_id" readonly value="<%= oldvalue.staff_id ?? '' %>"  />
                    </div>
                    
                    <div class="mb-2 col-md-4">
                        <label class="form-label mb-1">Signon Name</label>
                        <input class="form-control" name="signon_name" readonly value="<%= oldvalue.signon_name ?? '' %>"  />
                    </div>
                    
                    <div class="mb-2 col-md-6">
                        <label class="form-label mb-1">Full Name</label>
                        <input class="form-control" name="full_name" readonly value="<%= oldvalue.full_name ?? '' %>" />
                    </div>
                    
                    <div class="mb-2 col-md-4">
                        <label class="form-label mb-1">New Password</label>
                        <input class="form-control" type="password" name="NewPassword" />
                        <% if (errors && errors.NewPassword) { %><small class="text-danger"><%= errors.NewPassword[0] %></small><% } %>
                    </div>
                    
                    <div class="mb-2 col-md-4">
                        <label class="form-label mb-1">Confirm New Password</label>
                        <input class="form-control" type="password" name="ConfirmNewPassword" />
                        <% if (errors && errors.ConfirmNewPassword) { %><small class="text-danger"><%= errors.ConfirmNewPassword[0] %></small><% } %>
                    </div>

                    <div class="mb-2 col-md-4">
                        <label class="form-label mb-1">Clear Attemps</label>
                        <select class="form-select select2" name="reset_type" value="">
                            <option value="ATTEMP" <%= oldvalue.reset_type === 'ATTEMP' ? 'selected' : '' %>>Only Clear Attemps</option>
                            <option value="ATTEMP.PASSWORD" <%= oldvalue.reset_type !== 'ATTEMP' ? 'selected' : '' %>>Reset Password and Clear Attemps</option>
                        </select>
                        <% if (errors && errors.reset_type) { %><small class="text-danger"><%= errors.reset_type[0] %></small><% } %>
                    </div>

                </div>
            </div>

            <div class="tab-pane" id="tabAudit" role="tabpanel"></div>

        </div>

    </div>

</form>
