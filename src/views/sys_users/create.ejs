
<form class="card" method="post" action="<%= baseurl %>">

    <input type="hidden" name="recid" value="" />

    <div class="card-body border-bottom pb-2">
        <div class="d-flex align-items-center">
            <div class="flex-grow-1">
                <h5 class="mb-1 card-title"><%= pageTitle %></h5>
                <p class="text-muted mb-0"><%= pageDscr %></p>
            </div>
            <div class="flex-shrink-0">
                <button class="btn btn-soft-primary" type="submit" name="client-action" value="submit-create" title="Submit Create"><i class="fas fa-check"></i></button>
                <a class="btn btn-soft-secondary" role="button" href="<%= baseurl %>" title="Cancel"><i class="fas fa-level-up-alt"></i></a>
            </div>
        </div>
    </div>

    <div class="card-body">

        <%- include('../components/show_errors') %>
        
        <ul class="nav nav-tabs nav-tabs-custom" role="tablist">
            <li class="nav-item" role="presentation">
                <a class="nav-link active" data-bs-toggle="tab" href="#tabMaster" role="tab" aria-selected="true">
                    <span class="d-none d-sm-block">Master</span>
                </a>
            </li>
            <li class="nav-item" role="presentation">
                <a class="nav-link" data-bs-toggle="tab" href="#tabAudit" role="tab" aria-selected="false" tabindex="-1">
                    <span class="d-none d-sm-block">Audit</span>
                </a>
            </li>
        </ul>

        <div class="tab-content p-3 text-muted">
            
            <div class="tab-pane active" id="tabMaster" role="tabpanel">
                <div class="row g-2">
                    
                    <div class="mb-2 col-md-2">
                        <label class="form-label mb-1">Staff Id</label>
                        <input class="form-control" name="staff_id" value="<%= oldvalue.staff_id ??'' %>"  />
                        <% if (errors && errors.staff_id) { %><small class="text-danger"><%= errors.staff_id[0] %></small><% } %>
                    </div>
                    
                    <div class="mb-2 col-md-4">
                        <label class="form-label mb-1">Signon Name</label>
                        <input class="form-control" name="signon_name" value="<%= oldvalue.signon_name ??'' %>"  />
                        <% if (errors && errors.signon_name) { %><small class="text-danger"><%= errors.signon_name[0] %></small><% } %>
                    </div>
                    
                    <div class="mb-2 col-md-6">
                        <label class="form-label mb-1">Full Name</label>
                        <input class="form-control" name="full_name" value="<%= oldvalue.full_name ??'' %>"  />
                        <% if (errors && errors.full_name) { %><small class="text-danger"><%= errors.full_name[0] %></small><% } %>
                    </div>
                    
                    <div class="mb-2 col-md-6">
                        <label class="form-label mb-1">Default Branch</label>
                        <select class="form-select select2" name="id_branch" value="">
                            <% list_branches.forEach((item) => { %>
                                <option value="<%= item.id_branch %>" <%= String(oldvalue.id_branch ?? '') === item.id_branch ? 'selected' : '' %>><%= item.full_name %></option>
                            <% }) %>
                        </select>
                        <% if (errors && errors.id_branch) { %><small class="text-danger"><%= errors.id_branch[0] %></small><% } %>
                    </div>
                    
                    <div class="mb-2 col-md-2">
                        <label class="form-label mb-1">Date Start</label>
                        <div class="input-group" id="picker-date-start">
                            <input class="form-control" data-date-container="#picker-date-start" data-date-format="yyyy-mm-dd" data-provide="datepicker" type="text" name="date_start" value="<%= oldvalue.date_start ?? '' %>" />
                        </div>
                        <% if (errors && errors.date_start) { %><small class="text-danger"><%= errors.date_start[0] %></small><% } %>
                    </div>
                    
                    <div class="mb-2 col-md-2">
                        <label class="form-label mb-1">Date End</label>
                        <div class="input-group" id="picker-date-end">
                            <input class="form-control" data-date-container="#picker-date-end" data-date-format="yyyy-mm-dd" data-provide="datepicker" type="text" name="date_end" value="<%= oldvalue.date_end ?? '' %>" />
                        </div>
                        <% if (errors && errors.date_end) { %><small class="text-danger"><%= errors.date_end[0] %></small><% } %>
                    </div>
                    
                    <div class="mb-2 col-md-1">
                        <label class="form-label mb-1">Time Start</label>
                        <div class="input-group" id="picker-time-start-group">
                            <input class="form-control" data-provide="timepicker" id="picker-time-start" type="text" name="time_start" value="<%= oldvalue.time_start?? '' %>" />
                        </div>
                        <% if (errors && errors.time_start) { %><small class="text-danger"><%= errors.time_start[0] %></small><% } %>
                    </div>
                    
                    <div class="mb-2 col-md-1">
                        <label class="form-label mb-1">Time End</label>
                        <div class="input-group" id="picker-time-end-group">
                            <input class="form-control" data-provide="timepicker" id="picker-time-end" type="text" name="time_end" value="<%= oldvalue.time_end?? '' %>" />
                        </div>
                        <% if (errors && errors.time_end) { %><small class="text-danger"><%= errors.time_end[0] %></small><% } %>
                    </div>
                    
                    <div class="mb-2 col-md-12">
                        <label class="form-label mb-1">Access Privileges</label>
                        <% const selectedPrivileges = Array.isArray(oldvalue.id_privilege) ? oldvalue.id_privilege.map(String) : [String(oldvalue.id_privilege ?? '')]; %>
                        <select class="select2 form-control select2-multiple" data-placeholder="Choose ..." multiple="multiple" name="id_privilege">
                            <% list_privileges.forEach((item) => { %>
                                <option value="<%= item.id_privilege %>" <%= selectedPrivileges.includes(item.id_privilege) ? 'selected' : '' %>><%= item.full_name %></option>
                            <% }) %>
                        </select>
                        <% if (errors && errors.id_privilege) { %><small class="text-danger"><%= errors.id_privilege[0] %></small><% } %>
                    </div>

                </div>
            </div>

            <div class="tab-pane" id="tabAudit" role="tabpanel"></div>

        </div>

    </div>

</form>

<script>

    document.addEventListener("DOMContentLoaded", () => {
        "use strict";
        $("#picker-time-start").timepicker({
            showMeridian: !1,
            icons: { up: "mdi mdi-chevron-up", down: "mdi mdi-chevron-down" },
            appendWidgetTo: "#picker-time-start-group",
        });
        $("#picker-time-end").timepicker({
            showMeridian: !1,
            icons: { up: "mdi mdi-chevron-up", down: "mdi mdi-chevron-down" },
            appendWidgetTo: "#picker-time-end-group",
        });

    });

</script>